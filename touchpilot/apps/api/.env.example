# Copy to .env and fill in. .env is gitignored; this file must never hold a value.
#
# The service role key and the Stripe secret are the dangerous two: the first
# bypasses every row-level security rule in the database, the second can move
# money. Neither belongs in the desktop app, in a build, or in this repository.
# In production they are set with `fly secrets set`, never in the image.

# --- Supabase: auth and database -------------------------------------------
# Project settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
# Project settings -> API -> JWT secret. Used to verify tokens the app sends.
SUPABASE_JWT_SECRET=

# --- Stripe: payments, test mode ------------------------------------------
# Developers -> API keys. Must start with sk_test_ while testing.
STRIPE_SECRET_KEY=
# Created when you register the webhook endpoint. Verifying it is what stops
# anyone granting themselves a subscription by posting to the endpoint.
STRIPE_WEBHOOK_SECRET=
# The recurring price the checkout session uses.
STRIPE_PRICE_ID=

# --- Model provider --------------------------------------------------------
# Absent means the service runs in fixture mode and says so on every reply.
TOKI_PROVIDER_API_KEY=
TOKI_PROVIDER_BASE_URL=https://api.openai.com/v1
TOKI_GUIDANCE_MODEL=gpt-4o
TOKI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# --- Service ---------------------------------------------------------------
PORT=8787
# Guidance carries a base64 screenshot; a 4K display encodes to several MB.
TOKI_MAX_REQUEST_BYTES=12582912
TOKI_REQUESTS_PER_MINUTE=20
# Development only: keys the stub licence store accepts before real licences
# exist. The stub accepts nothing unless this is set, so that a deployment
# carrying a real credential and no store cannot serve the whole internet.
TOKI_DEV_LICENCE_KEYS=
