# Toki desktop build settings.
#
# Copy to `.env` in this directory. Vite reads it at build time and compiles the
# values into the app, so anything here ends up inside the shipped binary and
# must be safe to publish. Nothing secret belongs in this file.
#
# The user's own credentials are not configured here — they live in the macOS
# Keychain, set from Toki's Preferences window at runtime.

# The Supabase project sign-in runs against.
VITE_TOKI_SUPABASE_URL=https://your-project.supabase.co

# The "anon public" key from the project's API settings.
#
# Public by design: it identifies the project, it does not grant anything. Row
# level security in the database is what protects data, which is why the tables
# are locked down there rather than by keeping this string hidden. Never put the
# service role key here — that one bypasses every policy.
VITE_TOKI_SUPABASE_ANON_KEY=your-anon-public-key

# The hosted guidance service. Left unset, Toki runs against local fixtures.
# VITE_TOKI_GUIDANCE_ENDPOINT=https://toki-api.fly.dev
