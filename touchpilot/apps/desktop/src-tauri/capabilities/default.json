{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for Toki overlay, settings, preferences, and debug windows",
  "windows": [
    "overlay",
    "settings",
    "debug"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    "deep-link:default"
  ]
}
