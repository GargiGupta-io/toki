<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>LSUIElement</key>
  <true/>
  <key>NSCameraUsageDescription</key>
  <string>Toki uses the camera only when you enable gestures to track hand movement locally. Toki does not record or store camera frames.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Toki uses the microphone only while push-to-talk is held to understand your guidance request.</string>
  <key>NSScreenCaptureUsageDescription</key>
  <string>Toki uses screen recording access to inspect the visible app window and point to the next target you asked for. Toki does not control your computer.</string>
  <!--
    Sign-in happens in the browser, and this is how the browser gets back to
    Toki afterwards. macOS routes toki:// links to this app, launching it first
    if it is not already running, which is why the callback has to be handled on
    a cold start as well as while the app is open.
  -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>app.toki.desktop</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>toki</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
