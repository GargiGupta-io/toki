{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toki",
  "version": "0.1.0",
  "identifier": "app.toki.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": " ",
        "width": 1440,
        "height": 900,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "fullscreen": false,
        "visible": false,
        "focus": false,
        "focusable": false
      },
      {
        "label": "settings",
        "title": " ",
        "width": 400,
        "height": 218,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      },
      {
        "label": "preferences",
        "title": "Toki Preferences",
        "width": 520,
        "height": 460,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": true,
        "skipTaskbar": false,
        "visible": false
      },
      {
        "label": "debug",
        "title": "Toki Debug",
        "width": 760,
        "height": 620,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "resizable": true,
        "shadow": true,
        "skipTaskbar": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; media-src 'self' blob: mediastream:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "GargiGupta-io",
    "category": "Productivity",
    "shortDescription": "Cursor-first AI screen guidance assistant.",
    "longDescription": "Toki is a desktop guidance assistant that uses voice, screen context, and cursor-adjacent visual cues to help users find the next target without taking control of their computer.",
    "copyright": "Copyright 2026 GargiGupta-io",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
