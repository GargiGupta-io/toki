{
  "manifest_version": 3,
  "name": "Toki Candidate Companion",
  "version": "0.1.0",
  "description": "Extracts visible browser DOM candidates for local Toki guidance testing.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Toki candidates"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
