{
  "name": "toki",
  "private": true,
  "version": "1.0.0",
  "description": "Cross-platform AI screen guide with overlay, voice, and gesture control.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "node --import tsx --test scripts/*.test.mjs",
    "verify": "npm run check && npm test",
    "build": "npm run desktop:build",
    "check": "npm run typecheck && npm run rust:check",
    "check:fast": "npm run desktop:typecheck && npm run rust:check",
    "typecheck": "npm --workspace @toki/desktop run typecheck && npm --workspace @toki/shared run typecheck && npm --workspace @toki/ai run typecheck && npm --workspace @toki/ui run typecheck && npm --workspace @toki/evals run typecheck && npm --workspace @toki/design run typecheck && npm --workspace @toki/api run typecheck",
    "desktop:typecheck": "npm --workspace @toki/desktop run typecheck",
    "desktop:web:build": "npm --workspace @toki/desktop run build",
    "browser-extension:check": "npm --workspace @toki/browser-extension run check",
    "qa:browser:candidates": "node scripts/browser-candidate-bridge-qa.mjs",
    "qa:browser:known-screen": "node scripts/browser-known-screen-qa.mjs",
    "qa:fallback:known-screen": "node scripts/fallback-known-screen-qa.mjs",
    "qa:workflow:known-screen": "node --import tsx scripts/workflow-known-screen-qa.mjs",
    "qa:eval:known-screen": "npm --workspace @toki/evals run known-screen",
    "qa:visual:motion": "node scripts/visual-motion-qa.mjs",
    "qa:visual:manual": "bash scripts/macos-visual-manual-qa.sh",
    "rust:check": "cargo check --workspace",
    "rust:fmt": "cargo fmt --all",
    "guidance:smoke:dev": "node scripts/guidance-smoke-server.mjs",
    "guidance:smoke:freellmapi": "TOKI_GUIDANCE_PROVIDER=freellmapi-dev node scripts/guidance-smoke-server.mjs",
    "guidance:provider:check": "node scripts/guidance-provider-check.mjs",
    "guidance:known-screen": "node scripts/guidance-known-screen-smoke.mjs",
    "test:guidance:smoke": "node --test scripts/guidance-smoke-server.test.mjs scripts/candidate-ranking.test.mjs scripts/browser-candidate-payload.test.mjs scripts/macos-accessibility-candidates.test.mjs scripts/macos-vision-ocr-candidates.test.mjs",
    "test:coordinates": "node --import tsx --test scripts/coordinate-transforms.test.mjs",
    "test:provider-image": "node --import tsx --test scripts/provider-image-preparation.test.mjs",
    "test:candidate-fusion": "node --import tsx --test scripts/candidate-fusion.test.mjs",
    "test:candidate-intent": "node --import tsx --test scripts/candidate-intent-ranking.test.mjs",
    "test:guidance-planning": "node --import tsx --test scripts/guidance-task-planning.test.mjs",
    "test:vision-provider": "node --import tsx --test scripts/vision-provider-contract.test.mjs",
    "test:voice-hold": "node --import tsx --test scripts/voice-hold-controller.test.mjs",
    "test:capture-access": "node --import tsx --test scripts/capture-access.test.mjs",
    "test:macos-privacy": "node --test scripts/macos-privacy-usage-descriptions.test.mjs",
    "test:macos-release-signing": "node --test scripts/macos-release-signing.test.mjs",
    "test:puck-motion": "node --import tsx --test scripts/puck-motion.test.mjs",
    "test:target-cue": "node --import tsx --test scripts/target-cue-geometry.test.mjs",
    "test:target-verification": "node --import tsx --test scripts/target-verification.test.mjs",
    "test:command-corpus": "node --import tsx --test scripts/command-edge-case-corpus.test.mjs",
    "test:gesture-contracts": "node --import tsx --test scripts/gesture-contracts.test.mjs",
    "test:gesture-runtime": "node --import tsx --test scripts/gesture-runtime-ownership.test.mjs",
    "test:gesture-assets": "node --import tsx --test scripts/mediapipe-local-assets.test.mjs",
    "test:gesture-pointing": "node --import tsx --test scripts/gesture-pointing.test.mjs",
    "test:gesture-target-lock": "node --import tsx --test scripts/gesture-target-lock.test.mjs",
    "test:gesture-two-hand": "node --import tsx --test scripts/gesture-two-hand.test.mjs",
    "test:gesture-split-strand": "node --import tsx --test scripts/gesture-split-strand.test.mjs",
    "test:gesture-control-voice": "node --import tsx --test scripts/gesture-control-voice.test.mjs",
    "test:gesture-pointer-explanation": "node --import tsx --test scripts/gesture-pointer-explanation.test.mjs",
    "test:gesture-camera-control": "node --import tsx --test scripts/gesture-camera-control.test.mjs",
    "test:gesture-input-stability": "node --import tsx --test scripts/gesture-input-stability.test.mjs",
    "test:gesture-adaptive-profile": "node --import tsx --test scripts/gesture-adaptive-profile.test.mjs",
    "test:gesture-diagnostics": "node --import tsx --test scripts/gesture-diagnostics.test.mjs",
    "test:gesture-intent-arbiter": "node --import tsx --test scripts/gesture-intent-arbiter.test.mjs",
    "test:debug-export": "node --import tsx --test scripts/debug-export.test.mjs",
    "test:diagnostics-settings": "node --import tsx --test scripts/diagnostics-settings.test.mjs",
    "test:openai-key": "node --import tsx --test scripts/openai-key-storage.test.mjs",
    "test:csp": "node --test scripts/content-security-policy.test.mjs",
    "test:developer-cli-gate": "node --test scripts/developer-cli-gate.test.mjs",
    "test:app-updates": "node --import tsx --test scripts/app-updates.test.mjs",
    "test:api": "node --import tsx --test scripts/api-service.test.mjs",
    "test:api-auth": "node --import tsx --test scripts/api-auth.test.mjs",
    "test:api-schema": "node --test scripts/api-schema.test.mjs",
    "test:version-consistency": "node --test scripts/version-consistency.test.mjs",
    "test:performance-budget": "node --test scripts/performance-budget.test.mjs",
    "toki:debug": "node scripts/read-toki-debug.mjs",
    "toki:footprint": "node scripts/runtime-footprint.mjs",
    "toki:gesture-replay": "node --import tsx scripts/replay-toki-gesture.mjs",
    "desktop:dev:guidance-smoke": "VITE_TOKI_GUIDANCE_ENDPOINT=http://127.0.0.1:8787/api/guidance/smoke npm run desktop:dev",
    "desktop:dev:guidance-auto-smoke": "TOKI_AUTO_REAL_SMOKE=true VITE_TOKI_GUIDANCE_ENDPOINT=http://127.0.0.1:8787/api/guidance/smoke npm run desktop:dev",
    "desktop:dev": "npm --workspace @toki/desktop run tauri dev",
    "desktop:build": "npm --workspace @toki/desktop run tauri build",
    "desktop:bootstrap-signing:mac": "bash scripts/macos-bootstrap-signing-identity.sh",
    "desktop:release:mac": "npm --workspace @toki/desktop run tauri -- build --bundles app && npm run desktop:sign:mac",
    "desktop:sign:mac": "bash scripts/macos-sign-app.sh",
    "desktop:install:mac": "bash scripts/macos-sign-app.sh --install",
    "desktop:package:mac": "bash scripts/macos-package-dmg.sh",
    "desktop:notarize:mac": "bash scripts/macos-notarize-dmg.sh",
    "desktop:publish:mac": "bash scripts/macos-publish-update.sh",
    "desktop:build:windows": "powershell.exe -ExecutionPolicy Bypass -File scripts/windows-tauri-build.ps1",
    "desktop:release:windows:exe": "powershell.exe -ExecutionPolicy Bypass -File scripts/windows-tauri-build.ps1 -NoBundle",
    "desktop:release:exe": "powershell.exe -ExecutionPolicy Bypass -File scripts/windows-tauri-build.ps1 -NoBundle",
    "qa:mac:runtime": "bash scripts/macos-runtime-qa.sh",
    "qa:mac:capture": "cargo run -p toki-capture --example capture_probe",
    "qa:mac:mic": "cargo run -p toki-desktop --example mic_capture_probe",
    "qa:mac:transcribe": "cargo run -p toki-desktop --example voice_transcription_probe",
    "qa:mac:candidates": "node scripts/macos-accessibility-candidate-probe.mjs",
    "qa:mac:ocr:candidates": "node scripts/macos-vision-ocr-candidate-probe.mjs",
    "qa:windows:runtime": "powershell.exe -ExecutionPolicy Bypass -File scripts/windows-runtime-qa.ps1",
    "qa:windows:visual": "powershell.exe -ExecutionPolicy Bypass -File scripts/windows-visual-qa.ps1",
    "test:camera-reframing": "node --import tsx --test scripts/camera-reframing.test.mjs",
    "api:dev": "npm --workspace @toki/api run dev"
  }
}
